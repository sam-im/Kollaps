# Baremetal Dashboard Image
FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /

RUN apt-get update && \
    apt-get install -y \
      openssh-client \
      pkgconf \
      python3 \
      python3-venv \
      python3-pip && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip setuptools wheel

# Copy your source & setup.py
ADD ./kollaps /Kollaps/kollaps
ADD ./baremetal /Kollaps/baremetal
ADD ./setup.py /Kollaps/setup.py
ADD ./baremetal/.ssh /root/.ssh/

# Install Python deps, build wheels, install your package
RUN cp /Kollaps/kollaps/target/release/libcommunicationcore.so /Kollaps/kollaps/dashboard/ && \
    /opt/venv/bin/pip install dnspython flask docker kubernetes netifaces openssh_wrapper netaddr && \
    /opt/venv/bin/pip wheel --no-deps -w /Kollaps /Kollaps && \
    /opt/venv/bin/pip install /Kollaps/kollaps-2.0-py3-none-any.whl


RUN apt-get purge -y python3-pip python3-venv && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# If you end up updating the binaries inside the baremetal directory or, depend on the newer versions, know that,
# the Dashboard API has changed and you will need to provide the type of the deployment as the first argument.
# i.e. you will need to use the following instead:
# ENTRYPOINT ["/opt/venv/bin/python3", "-m", "kollaps.dashboard.Dashboard", "baremetal", "baremetal/topology.xml"]
ENTRYPOINT ["/opt/venv/bin/python3", "-m", "kollaps.dashboard.Dashboard", "baremetal/topology.xml"]
