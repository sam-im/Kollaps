FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /

RUN apt-get update && \
    apt-get install -y\
      python3 \
      python3-venv \
      python3-pip && \
    apt-get clean -y

RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip setuptools wheel

COPY ./kollaps /Kollaps/kollaps
COPY ./setup.py /Kollaps/setup.py

RUN /opt/venv/bin/pip install dnspython flask docker kubernetes netifaces openssh_wrapper netaddr && \
    /opt/venv/bin/pip wheel --no-deps -w /Kollaps /Kollaps && \
    /opt/venv/bin/pip install /Kollaps

RUN apt-get purge -y python3-pip python3-venv && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*
