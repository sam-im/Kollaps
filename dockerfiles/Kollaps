FROM debian:12

WORKDIR /

ENV DEBIAN_FRONTEND=noninteractive \
    TC_LIB_DIR=/usr/lib/tc/ \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && \
    apt-get install -y \
    curl \
    build-essential \
    flex \
    bison \
    gettext \
    grep \
    iproute2 \
    iptables \
    pkgconf \
    python3 \
    python3-venv \
    python3-pip && \
    apt-get clean -y

RUN python3 -m venv /opt/venv

RUN /opt/venv/bin/pip install --upgrade pip setuptools wheel

RUN /opt/venv/bin/pip install \
    dnspython flask docker kubernetes netifaces openssh_wrapper netaddr requests==2.31.0

ADD ./kollaps/ /Kollaps/kollaps
ADD ./setup.py /Kollaps/setup.py

RUN make -C /Kollaps/kollaps/tools/pid1 && \
    cp /Kollaps/kollaps/tools/pid1/pid1 /usr/bin/pid1 && \
    make -C /Kollaps/kollaps/TCAL -j8 && \
    cp /Kollaps/kollaps/TCAL/libTCAL.so /usr/local/bin/libTCAL.so

# TODO remove libcommunicationcore.so from /usr/local/bin as only dashboard uses it
RUN cp /Kollaps/kollaps/target/release/communicationmanager /usr/bin/communicationmanager  && \
    cp /Kollaps/kollaps/target/release/emulationcore /usr/bin/emulationcore  && \
    cp /Kollaps/kollaps/target/release/libcommunicationcore.so /usr/local/bin/libcommunicationcore.so && \
    cp /Kollaps/kollaps/target/release/libcommunicationcore.so /Kollaps/kollaps/dashboard/

RUN /opt/venv/bin/pip wheel --no-deps -w /Kollaps /Kollaps && \
    /opt/venv/bin/pip install /Kollaps/kollaps-2.0-py3-none-any.whl

RUN /opt/venv/bin/pip uninstall -y setuptools wheel pip && \
    rm -rf /Kollaps

ENTRYPOINT ["/usr/bin/pid1", "/opt/venv/bin/python3", "-m", "kollaps.tools.bootstrapping.Bootstrapper"]
