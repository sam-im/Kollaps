FROM debian:12

WORKDIR /

ENV DEBIAN_FRONTEND=noninteractive \
    TC_LIB_DIR=/usr/lib/tc/ \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && \
    apt-get install -y \
    curl \
    build-essential \
    flex \
    bison \
    gettext \
    grep \
    iproute2 \
    iptables \
    pkgconf \
    python3 \
    python3-venv \
    python3-pip && \
    apt-get clean -y

RUN python3 -m venv /opt/venv

RUN /opt/venv/bin/pip install --upgrade pip setuptools wheel

RUN /opt/venv/bin/pip install \
    dnspython flask docker kubernetes netifaces openssh_wrapper netaddr requests==2.31.0

ADD ./kollaps/ /Kollaps/kollaps
ADD ./setup.py /Kollaps/setup.py

# For development you might want to comment out the following RUN statement and
# uncomment the one just after it. 
RUN curl -L -O "https://github.com/sam-im/Kollaps/releases/download/2.1.0/kollaps-binaries.tar.gz" && \
    tar -xzf kollaps-binaries.tar.gz && \
    mv kollaps-binaries/pid1 /usr/bin/ && \
    mv kollaps-binaries/libTCAL.so /usr/bin/ && \
    mv kollaps-binaries/communicationmanager /usr/bin/ && \
    mv kollaps-binaries/emulationcore /usr/bin/ && \                            
    mv kollaps-binaries/libcommunicationcore.so /Kollaps/kollaps/dashboard/

# For build instructions, see `Kollaps/kollaps/README.md`.
# RUN cp /Kollaps/kollaps/tools/pid1/pid1 /usr/bin/ && \
#     cp /Kollaps/kollaps/TCAL/libTCAL.so /usr/bin/ && \
#     cp /Kollaps/kollaps/target/release/communicationmanager /usr/bin/ && \
#     cp /Kollaps/kollaps/target/release/emulationcore /usr/bin/ && \
#     cp /Kollaps/kollaps/target/release/libcommunicationcore.so /Kollaps/kollaps/dashboard/

RUN /opt/venv/bin/pip wheel --no-deps -w /Kollaps /Kollaps && \
    /opt/venv/bin/pip install /Kollaps/kollaps-2.0-py3-none-any.whl

RUN /opt/venv/bin/pip uninstall -y setuptools wheel pip && \
    rm -rf /Kollaps

ENTRYPOINT ["/usr/bin/pid1", "/opt/venv/bin/python3", "-m", "kollaps.bootstrapper.main"]
